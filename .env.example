# ==========================================================
# Docker Compose 环境变量 —— 模板文件
# ==========================================================
# 复制成 .env 后按本机情况改：cp .env.example .env
# （.env 含口令，已在 .gitignore 中，不要提交进仓库）

# Docker Hub 镜像加速前缀
#   - 中国大陆 / registry-1.docker.io 不可直连时保留此值
#   - 海外环境或已配置 Docker Desktop registry-mirror 时置空即可
#   - docker.elastic.co / ghcr.io / quay.io 直连，不加此前缀
REGISTRY_PREFIX=docker.m.daocloud.io/

# Kafka 对外暴露端口（9092 被占时改这里，并同步 application-dev.yml）
KAFKA_HOST_PORT=9092

# ES 对外暴露端口（9200 被占时顺延）
ES_HOST_PORT=9250

# MySQL 对外暴露端口（本机 3306 被原生 MySQL 占用，故顺延）
MYSQL_HOST_PORT=3309

# 本地开发用的库口令 —— 必填，自行取值。
# 后端 application.yml 里读取的是 XK_MYSQL_PASSWORD，默认值只对本地 compose 生效；
# 真实环境请用环境变量注入，不要把口令写进任何入库文件。
MYSQL_ROOT_PASSWORD=请改成你自己的口令
