deploy/es/ik/

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 本地敏感配置（MySQL / Redis / OSS 密钥等）=====
# application.yml 中只放占位符，真实值写在这里；此文件不入库
# 注意：.env 必须一并忽略 —— 它含明文 MYSQL_ROOT_PASSWORD。
# 只有 .env.example（无敏感值）才允许入库
.env
.env.local
# 生产环境模板 .env.prod.example 入库，实际文件 .env.prod 入库前强制忽略
.env.prod
.env.*.local
!.env.prod.example
backend/src/main/resources/application-local.yml

# mvnw 重定向的 stderr（后端本地启动日志）
*.log.err

# ===== 本地验收产物（一轮就清，绝不入库）=====
# img/ 是截图目录，几十 MB 且结论都已写进 AGENTS.md
img/
logs-vite.txt
# frontend/scripts/_*.mjs：一次性探针/截图脚本。带下划线前缀就是为了
# 「一眼看出不是正式测试」，但光靠约定不够，这里再兜一道 —— 否则
# 某轮探针混进提交里，prod 验收脚本就跟着入库了。
frontend/scripts/_*.mjs
