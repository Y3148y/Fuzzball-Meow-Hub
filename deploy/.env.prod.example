# =====================================================================
#  毛球喵社 —— 生产环境变量模板
#  用法：cp .env.prod.example .env.prod，然后改下面的值
#  .env.prod 含口令，加入 .gitignore、绝不提交
#
#  其中两个是**必填**项，`${VAR:?...}` 会让 compose 在缺少时直接报错退出：
#   - MYSQL_ROOT_PASSWORD：生产库口令，不要复用开发库那一个
#   - XK_JWT_SECRET：至少 32 字节的随机串，生成：openssl rand -base64 64
# =====================================================================

# Docker Hub 镜像加速前缀（中国大陆不可直连 docker.io 时保留）
# 海外环境或 Docker Desktop 已配 registry-mirror 时置空
REGISTRY_PREFIX=docker.m.daocloud.io/

# ---------------- 必填 ----------------
# 生产 MySQL 根口令（后端 XK_MYSQL_PASSWORD 与之同步注入）
MYSQL_ROOT_PASSWORD=
# JWT 签名密钥，>=32 字节，随机生成，别用开发用的那个
XK_JWT_SECRET=

# ---------------- 可选（有合理的默认值） ----------------
# 前端对外端口
XK_WEB_PORT=80

# 后端监听端口（容器内；一般不用改）
XK_SERVER_PORT=8088

# 雪花 ID 机器位。多实例部署每个实例必须互不相同
XK_MACHINE_ID=1

# Redis 逻辑库号（与开发环境隔开避免 key 冲突）
XK_REDIS_DB=3

# 图片存储：local = 挂在 /app/uploads 的卷；s3 = 任意 S3 兼容端点
# 用 s3 时再补 XK_S3_ENDPOINT / XK_S3_REGION / XK_S3_ACCESS_KEY /
# XK_S3_SECRET_KEY / XK_S3_BUCKET（后端 application.yml 里的同名变量）
XK_STORAGE_TYPE=local